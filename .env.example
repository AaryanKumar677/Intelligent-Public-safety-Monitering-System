# =====================================================================
# Intelligent Public Transport Safety Monitoring System
# Environment Credentials & Node Settings Template (.env.example)
# =====================================================================
# QUICK-START GUIDE: 
# 1. Copy this file to a new file named '.env' in the same root folder:
#    cp .env.example .env
# 2. Populate your specific Firebase database URL and Telegram Bot tokens.
# WARNING: NEVER commit genuine .env files or secret keys to Version Control!
# =====================================================================

# ---------------------------------------------------------------------
# 1. GOOGLE FIREBASE REALTIME DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# URL of your active Firebase Realtime Database instance
FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com/"
# Path to downloaded GCP Service Account Private JSON Key
FIREBASE_SERVICE_ACCOUNT_KEY="credentials/firebase_service_account.json"
# Maximum items retained in memory queue during network disconnects (Offline Buffering)
OFFLINE_BUFFER_MAX_SIZE="50"
# Seconds between reconnection broadcast attempts for offline buffer flush
RETRY_FLUSH_INTERVAL_SEC="3.0"

# ---------------------------------------------------------------------
# 2. HARDWARE SENSOR BINDINGS (CONFIRMED DEFAULTS)
# ---------------------------------------------------------------------
# Default integrated microphone input interface (0 for primary laptop mic)
AUDIO_DEVICE_INDEX="0"
# Default optical camera capture device (0 for built-in webcam, 1+ for external USB)
VISION_CAMERA_INDEX="0"

# ---------------------------------------------------------------------
# 3. AI DETECTION & ANOMALY THRESHOLDS
# ---------------------------------------------------------------------
# Passenger density count required to trigger cabin overcrowding alarm
CROWD_THRESHOLD_COUNT="5"
# Duration (seconds) overcrowded conditions must persist to prevent fleeting flicker alarms
CROWD_HYSTERESIS_SEC="2.0"
# Acoustic confidence debounce cooldown (seconds between repeating vocal alarms)
AUDIO_DEBOUNCE_SEC="8.0"

# ---------------------------------------------------------------------
# 4. NOTIFICATION GATEWAY (TELEGRAM BOT API)
# ---------------------------------------------------------------------
# Confirmed operational primary messaging fallback: 'telegram' (or 'mock' for local prints)
NOTIFICATION_PROVIDER="telegram"

# Telegram Bot Setup via Telegram App:
# 1. Search for @BotFather on Telegram, type /newbot, and follow prompt to get token.
# 2. Search for @userinfobot to retrieve your numerical Chat ID (or group ID).
TELEGRAM_BOT_TOKEN="1234567890:AAH_aBcDeFgHiJkLmNoPqRsTuVwXyZ09876"
TELEGRAM_CHAT_ID="-1001234567890"

# ---------------------------------------------------------------------
# 5. SIMULATED EDGE TRANSIT VEHICLE IDENTIFIER
# ---------------------------------------------------------------------
VEHICLE_ID="BUS-104-DL01"
VEHICLE_ROUTE="ROUTE_412_METRO_LINK"
TELEMETRY_INTERVAL_SEC="2.0"
